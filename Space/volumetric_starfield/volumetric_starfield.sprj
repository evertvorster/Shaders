				<variable type="float4x4" name="matGeo" system="GeometryTransform" />
				<variable type="float2" name="iResolution" system="ViewportSize" />
				<variable type="float2" name="iMouse" system="MousePosition" />
				<variable type="float" name="iTime" system="Time" />
				<variable type="float4x4" name="uView" system="View" />
				<variable type="float4x4" name="uProj" system="Projection" />
				<variable type="float3" name="uCamPos" system="CameraPosition3" />
				<variable type="float" name="uStvCell">
					<row><value>2.0</value></row>
				</variable>
				<variable type="float" name="uStvDensity">
					<row><value>0.50</value></row>
				</variable>
				<variable type="float" name="uStvView">
					<row><value>100.0</value></row>
				</variable>
				<variable type="float" name="uStvAng">
					<row><value>0.0016</value></row>
				</variable>
				<variable type="float" name="uStvBright">
					<row><value>2.0</value></row>
				</variable>
				<variable type="float" name="uStvFalloff">
					<row><value>0.0020</value></row>
				</variable>
				<variable type="float" name="uStvSeed">
					<row><value>0.0</value></row>
				</variable>
			</variables>
			<macros />
		</pass>
	</pipeline>
	<objects />
	<cameras />
	<settings>
