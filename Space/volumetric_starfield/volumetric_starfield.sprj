<?xml version="1.0"?>
<project version="2">
	<pipeline>
		<pass name="volumetric_starfield" type="shader" active="true" patchverts="1">
			<shader type="vs" path="volumetric_starfield.vert" entry="main" />
			<shader type="ps" path="volumetric_starfield.glsl" entry="main" />
			<inputlayout>
				<item value="Position" semantic="POSITION" />
				<item value="Normal" semantic="NORMAL" />
				<item value="Texcoord" semantic="TEXCOORD0" />
