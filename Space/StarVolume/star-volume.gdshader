shader_type spatial;
// GENERATED by Tools/build_starvolume.py from the source's .frag -- do not edit by hand.
render_mode unshaded, cull_disabled, depth_draw_never, blend_mix, skip_vertex_transform;

uniform float uStvCell : hint_range(1, 50, 0.1) = 2.0;  // cell size in world units: bigger = fewer, further apart
uniform float uStvDensity : hint_range(0, 1, 0.01) = 0.50;  // fraction of cells that hold a star
uniform float uStvView : hint_range(10, 500, 1) = 100.0;  // how far the local volume reaches
uniform float uStvAng : hint_range(0.0002, 0.006, 1e-05) = 0.0016;  // star angular radius (direction units)
uniform float uStvBright : hint_range(0, 6, 0.01) = 2.0;  // exposure
uniform float uStvFalloff : hint_range(0.0001, 0.05, 0.0001) = 0.0020;  // inverse-square scale: bigger = stars dim faster with distance
uniform float uStvSeed : hint_range(0, 100, 1) = 0.0;  // lattice seed
uniform mat4 uView;
uniform mat4 uProj;
uniform vec3 uCamPos;
uniform float uPxPerDir;
uniform float uSteps;

varying vec3 v_dir;

void vertex() {
	// Godot's VERTEX inside fragment() is view space, so the direction is computed here and
	// passed down as a varying. (Trap, and it cost us once.)
	VERTEX = (MODELVIEW_MATRIX * vec4(VERTEX, 1.0)).xyz;
	POSITION = PROJECTION_MATRIX * vec4(VERTEX, 1.0);
	v_dir = normalize((INV_VIEW_MATRIX * vec4(VERTEX, 0.0)).xyz);
}

void fragment() {
	float dither = ign(FRAGCOORD.xy);
	vec3 transmittance;
	vec3 col = starVolumeSky(uCamPos, normalize(v_dir), uPxPerDir, dither, transmittance);
	ALBEDO = pow(aces(col), vec3(0.4545));
}
