<?xml version="1.0"?>
<project version="2">
	<pipeline>
		<pass name="analytic-galaxy" type="shader" active="true" patchverts="1">
			<shader type="vs" path="analytic-galaxy.vert" entry="main" />
			<shader type="ps" path="analytic-galaxy.glsl" entry="main" />
			<inputlayout>
				<item value="Position" semantic="POSITION" />
				<item value="Normal" semantic="NORMAL" />
				<item value="Texcoord" semantic="TEXCOORD0" />
			</inputlayout>
			<rendertexture />
			<items>
				<item name="FS" type="geometry">
					<type>ScreenQuad</type>
					<width>1</width>
					<height>1</height>
					<depth>1</depth>
					<topology>TriangleList</topology>
				</item>
			</items>
			<itemvalues />
			<variables>
				<variable type="float4x4" name="matVP" system="Orthographic" />
				<variable type="float4x4" name="matGeo" system="GeometryTransform" />
				<variable type="float2" name="iResolution" system="ViewportSize" />
				<variable type="float2" name="iMouse" system="MousePosition" />
				<variable type="float" name="iTime" system="Time" />
				<variable type="float4x4" name="uView" system="View" />
				<variable type="float4x4" name="uProj" system="Projection" />
				<variable type="float3" name="uCamPos" system="CameraPosition3" />
				<variable type="float" name="uGalPitch">
					<row><value>0.00</value></row>
				</variable>
				<variable type="float" name="uGalYaw">
					<row><value>0.00</value></row>
				</variable>
				<variable type="float" name="uGalEmission">
					<row><value>0.25</value></row>
				</variable>
				<variable type="float" name="uGalDust">
					<row><value>2.50</value></row>
				</variable>
				<variable type="float" name="uGalTurb">
					<row><value>0.80</value></row>
				</variable>
				<variable type="float" name="uGalNoiseScale">
					<row><value>0.50</value></row>
				</variable>
				<variable type="float" name="uGalArmCount">
					<row><value>2.00</value></row>
				</variable>
				<variable type="float" name="uGalArmTwist">
					<row><value>4.00</value></row>
				</variable>
				<variable type="float" name="uGalArmStrength">
					<row><value>0.60</value></row>
				</variable>
				<variable type="float" name="uGalSoftness">
					<row><value>0.08</value></row>
				</variable>
				<variable type="float" name="uGalBright">
					<row><value>1.00</value></row>
				</variable>
			</variables>
			<macros />
		</pass>
	</pipeline>
	<objects />
	<cameras />
	<settings>
		<entry type="property" name="analytic-galaxy" item="pipe" />
		<entry type="file" name="analytic-galaxy" shader="vs" />
		<entry type="file" name="analytic-galaxy" shader="ps" />
		<entry type="camera" fp="false">
			<distance>3</distance>
			<pitch>20</pitch>
			<yaw>45</yaw>
			<roll>360</roll>
		</entry>
		<entry type="clearcolor" r="0" g="0" b="0" a="1" />
		<entry type="usealpha" val="false" />
	</settings>
	<plugindata />
</project>
