<?xml version="1.0"?>
<project version="2">
	<pipeline>
		<pass name="Starfield" type="shader" active="true" patchverts="1">
			<shader type="vs" path="starfield.vert" entry="main" />
			<shader type="ps" path="starfield.glsl" entry="main" />
			<inputlayout>
				<item value="Position" semantic="POSITION" />
				<item value="Normal" semantic="NORMAL" />
				<item value="Texcoord" semantic="TEXCOORD0" />
			</inputlayout>
			<rendertexture />
			<items>
				<item name="FS" type="geometry">
					<type>ScreenQuad</type>
					<width>1</width>
					<height>1</height>
					<depth>1</depth>
					<topology>TriangleList</topology>
				</item>
			</items>
			<itemvalues />
			<variables>
				<variable type="float4x4" name="matVP" system="Orthographic" />
				<variable type="float4x4" name="matGeo" system="GeometryTransform" />
				<variable type="float2" name="iResolution" system="ViewportSize" />
				<variable type="float2" name="iMouse" system="MousePosition" />
				<variable type="float" name="iTime" system="Time" />
				<variable type="float" name="uStarSize">
					<row><value>1.00</value></row>
				</variable>
				<variable type="float" name="uStarFieldSize">
					<row><value>0.80</value></row>
				</variable>
				<variable type="float" name="uStarDensity">
					<row><value>60.0</value></row>
				</variable>
				<variable type="float" name="uStarCluster">
					<row><value>0.00</value></row>
				</variable>
				<variable type="float" name="uStarClusterScale">
					<row><value>4.00</value></row>
				</variable>
				<variable type="float" name="uStarBright">
					<row><value>1.00</value></row>
				</variable>
				<variable type="float" name="uStarGlow">
					<row><value>1.00</value></row>
				</variable>
				<variable type="float" name="uStarCount">
					<row><value>0.60</value></row>
				</variable>
			</variables>
			<macros />
		</pass>
	</pipeline>
	<objects />
	<cameras />
	<settings>
		<entry type="property" name="Starfield" item="pipe" />
